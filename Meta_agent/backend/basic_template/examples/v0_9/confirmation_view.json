{
  "updateComponents": {
    "surfaceId": "sur_confirm_123",
    "components": [
      {
        "component": "Column",
        "id": "root",
        "children": [
          "confirm_card"
        ]
      },
      {
        "component": "Card",
        "id": "confirm_card",
        "child": "confirm_content"
      },
      {
        "component": "Column",
        "id": "confirm_content",
        "children": [
          "confirm_header",
          "pizza_img_confirm",
          "details_name",
          "details_toppings",
          "details_quantity",
          "details_customer",
          "details_address"
        ]
      },
      {
        "component": "Text",
        "id": "confirm_header",
        "text": "Order Confirmed!"
      },
      {
        "component": "Image",
        "id": "pizza_img_confirm",
        "url": "${result.pizza_image_url}"
      },
      {
        "component": "Text",
        "id": "pizza_name_confirm",
        "text": "Pizza: ${result.pizza_name}"
      },
      {
        "component": "Text",
        "id": "pizza_toppings_confirm",
        "text": "Toppings: ${result.toppings}"
      },
      {
        "component": "Text",
        "id": "pizza_quantity_confirm",
        "text": "Quantity: ${result.quantity}"
      },
      {
        "component": "Text",
        "id": "pizza_name_input_confirm",
        "text": "Name: ${result.customer_name}"
      },
      {
        "component": "Text",
        "id": "pizza_address_confirm",
        "text": "Delivering to: ${result.address}"
      }
    ]
  }
}