[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "clinic_intake_surface",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "clinic_intake_surface",
      "components": [
        {
          "component": "Column",
          "id": "root",
          "children": [
            "intake_card"
          ]
        },
        {
          "component": "Card",
          "id": "intake_card",
          "child": "intake_content"
        },
        {
          "component": "Column",
          "id": "intake_content",
          "children": [
            "intake_header",
            "doctor_picker",
            "name_input",
            "age_input",
            "weight_input",
            "first_visit_check",
            "check_avail_btn"
          ]
        },
        {
          "component": "Text",
          "id": "intake_header",
          "variant": "h4",
          "text": "Patient Information for Cardiology"
        },
        {
          "component": "ChoicePicker",
          "id": "doctor_picker",
          "label": "Select a Doctor",
          "variant": "mutuallyExclusive",
          "options": [
            {
              "label": "Dr. Alice Martin",
              "value": "Dr. Alice Martin"
            },
            {
              "label": "Dr. Bob Chen",
              "value": "Dr. Bob Chen"
            },
            {
              "label": "Dr. Carol White",
              "value": "Dr. Carol White"
            },
            {
              "label": "Dr. David Green",
              "value": "Dr. David Green"
            },
            {
              "label": "Dr. Eve Black",
              "value": "Dr. Eve Black"
            },
            {
              "label": "Dr. Frank Blue",
              "value": "Dr. Frank Blue"
            }
          ],
          "value": {
            "path": "/application/doctor"
          }
        },
        {
          "component": "TextField",
          "id": "name_input",
          "label": "Patient Full Name",
          "value": {
            "path": "/application/patient_name"
          }
        },
        {
          "component": "TextField",
          "id": "age_input",
          "label": "Patient Age",
          "variant": "number",
          "value": {
            "path": "/application/patient_age"
          }
        },
        {
          "component": "TextField",
          "id": "weight_input",
          "label": "Patient Weight (in kg)",
          "variant": "number",
          "value": {
            "path": "/application/patient_weight"
          }
        },
        {
          "component": "CheckBox",
          "id": "first_visit_check",
          "label": "Is this your first visit?",
          "value": {
            "path": "/application/first_visit"
          }
        },
        {
          "component": "Button",
          "id": "check_avail_btn",
          "child": "check_avail_btn_txt",
          "action": {
            "event": {
              "name": "check_doctor_availability",
              "context": {
                "doctor": {
                  "path": "/application/doctor"
                },
                "patient_name": {
                  "path": "/application/patient_name"
                },
                "patient_age": {
                  "path": "/application/patient_age"
                },
                "patient_weight": {
                  "path": "/application/patient_weight"
                },
                "first_visit": {
                  "path": "/application/first_visit"
                }
              }
            }
          }
        },
        {
          "component": "Text",
          "id": "check_avail_btn_txt",
          "text": "Check Doctor Availability"
        }
      ]
    }
  }
]
