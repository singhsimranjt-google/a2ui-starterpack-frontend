# Google GenAI / Gemini API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Google Cloud Vertex AI configuration
# When GOOGLE_GENAI_USE_VERTEXAI=TRUE, GEMINI_API_KEY is NOT required -
# authentication uses Application Default Credentials (gcloud auth
# application-default login) plus the project/location below.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Optional: meta_json.py generator overrides
# All of these have sane defaults in meta_json.py - only set them here if you
# want to change the behaviour without editing code.
# ---------------------------------------------------------------------------
# Model used by each of the three stages (default: gemini-2.5-pro).
# e.g. run a cheaper Critic:  CRITIC_MODEL=gemini-2.5-flash
# PLANNER_MODEL=gemini-2.5-pro
# CODER_MODEL=gemini-2.5-pro
# CRITIC_MODEL=gemini-2.5-pro

# How many times the Coder is asked to fix its output (default: 3).
# MAX_RETRIES=3

# Golden template directory cloned for each new agent (default: basic_template).
# TEMPLATE_DIR_NAME=basic_template

# Folder name used when the Coder emits an unsafe/reserved one
# (default: generated_agent).
# FALLBACK_AGENT_NAME=generated_agent

# Master switch for the greeting / capabilities card in generated agents.
# true (default) = always injected unless the user explicitly opts out.
# false          = never injected.
# WELCOME_VIEW_ENABLED=true
