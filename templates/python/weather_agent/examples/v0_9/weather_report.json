[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "weather_report_surface",
      "catalogId": "https://a2ui.org/specification/v0_9/material_catalog.json",
      "sendDataModel": true
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "weather_report_surface",
      "components": [
        {
          "id": "root",
          "component": "MaterialColumn",
          "children": [
            "main_card"
          ],
          "style": {
            "maxWidth": "760px",
            "margin": "0 auto",
            "padding": "8px"
          }
        },
        {
          "id": "main_card",
          "component": "MaterialCard",
          "appearance": "raised",
          "align": "stretch",
          "style": {
            "padding": "16px 20px"
          },
          "children": [
            "header_row",
            "header_divider",
            "metrics_card",
            "bottom_divider",
            "actions_row"
          ]
        },
        {
          "id": "header_row",
          "component": "MaterialRow",
          "align": "center",
          "justify": "start",
          "style": {
            "padding": "2px 0"
          },
          "children": [
            "header_icon",
            "header_text_col"
          ]
        },
        {
          "id": "header_icon",
          "component": "MaterialIcon",
          "icon": "wb_sunny",
          "color": "primary"
        },
        {
          "id": "header_text_col",
          "component": "MaterialColumn",
          "style": {
            "paddingLeft": "10px"
          },
          "children": [
            "header_title",
            "header_subtitle"
          ]
        },
        {
          "id": "header_title",
          "component": "MaterialText",
          "text": "Weather in Delhi",
          "usageHint": "h2"
        },
        {
          "id": "header_subtitle",
          "component": "MaterialText",
          "text": "Current Conditions • Partly Cloudy with Fog",
          "usageHint": "caption"
        },
        {
          "id": "header_divider",
          "component": "MaterialDivider",
          "inset": false,
          "style": {
            "margin": "12px 0"
          }
        },
        {
          "id": "metrics_card",
          "component": "MaterialCard",
          "appearance": "outlined",
          "align": "stretch",
          "style": {
            "padding": "14px 18px",
            "margin": "8px 0"
          },
          "children": [
            "temp_line",
            "condition_line",
            "humidity_line",
            "wind_line"
          ]
        },
        {
          "id": "temp_line",
          "component": "MaterialText",
          "text": "🌡️ Temperature: 18°C (64°F)",
          "usageHint": "body"
        },
        {
          "id": "condition_line",
          "component": "MaterialText",
          "text": "🌤️ Condition: Partly Cloudy with Fog",
          "usageHint": "body"
        },
        {
          "id": "humidity_line",
          "component": "MaterialText",
          "text": "💧 Humidity: 74%",
          "usageHint": "body"
        },
        {
          "id": "wind_line",
          "component": "MaterialText",
          "text": "💨 Wind Speed: 15 km/h W",
          "usageHint": "body"
        },
        {
          "id": "bottom_divider",
          "component": "MaterialDivider",
          "inset": false,
          "style": {
            "margin": "14px 0"
          }
        },
        {
          "id": "actions_row",
          "component": "MaterialRow",
          "align": "center",
          "justify": "start",
          "children": [
            "btn_bengaluru",
            "btn_kolkata"
          ]
        },
        {
          "id": "btn_bengaluru",
          "component": "MaterialButton",
          "label": "Check Bengaluru",
          "icon": "wb_sunny",
          "variant": "raised",
          "action": {
            "event": {
              "name": "check_weather",
              "context": {
                "prompt": "What is the weather in Bengaluru?"
              }
            }
          }
        },
        {
          "id": "btn_kolkata",
          "component": "MaterialButton",
          "label": "Check Kolkata",
          "icon": "wb_cloudy",
          "variant": "text",
          "style": {
            "marginLeft": "12px"
          },
          "action": {
            "event": {
              "name": "check_weather",
              "context": {
                "prompt": "What is the weather in Kolkata?"
              }
            }
          }
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "weather_report_surface",
      "path": "/",
      "value": {
        "city": "Delhi",
        "temperature": "18°C (64°F)",
        "condition": "Partly Cloudy with Fog",
        "humidity": "74%",
        "wind": "15 km/h W"
      }
    }
  }
]
